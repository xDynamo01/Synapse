component Orbit inherits Path {
    viewbox-width: 500;
    viewbox-height: 500;
    fill: transparent;
    stroke-width: 1px;
    animate transform-rotation { duration: 2100ms; easing: ease-in-out; }
}

export component PresenceGraphic inherits Rectangle {
    in property <color> signal;
    in property <bool> suspended;
    property <bool> breath;
    property <angle> phase;
    property <length> diameter: min(root.width * 0.9, root.height * 0.99, 650px);

    Timer {
        interval: 42ms; running: !root.suspended;
        triggered => { root.phase = root.phase >= 359.3deg ? 0deg : root.phase + 0.7deg; }
    }
    Timer { interval: 2200ms; running: !root.suspended; triggered => { root.breath = !root.breath; } }

    field := Rectangle {
        width: root.diameter; height: self.width;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        Rectangle {
            width: parent.width * 0.98; height: self.width;
            x: (parent.width - self.width) / 2; y: self.x;
            background: @radial-gradient(circle, #142331 0%, #10101e 38%, transparent 73%);
        }
        Rectangle {
            width: parent.width * 0.55; height: self.width;
            x: (parent.width - self.width) / 2; y: self.x;
            background: @radial-gradient(circle, #dcfbff 0%, root.signal.with-alpha(0.91) 4%, root.signal.with-alpha(root.breath ? 0.52 : 0.37) 18%, #5c41ba32 36%, transparent 72%);
        }
        Orbit { width: field.width; height: field.height; commands: "M 473.1 275.7 A 225 218.3 -8 0 1 371.7 432.6 M 292.0 464.2 A 225 218.3 -8 0 1 117.1 427.2 M 52.9 356.7 A 225 218.3 -8 0 1 33.0 194.4 M 86.2 101.7 A 225 218.3 -8 0 1 262.7 31.9 M 345.9 51.7 A 225 218.3 -8 0 1 464.2 181.6"; stroke: root.signal.with-alpha(0.7); stroke-width: 1.2px; transform-rotation: root.breath ? 3deg : 0deg; }
        Orbit { width: field.width; height: field.height; commands: "M 404.4 379.7 A 206 160.7 25 0 1 239.6 414.7 M 178.8 394.1 A 206 160.7 25 0 1 61.1 271.1 M 51.6 209.3 A 206 160.7 25 0 1 124.9 100.4 M 198.5 80.8 A 206 160.7 25 0 1 375.0 140.7 M 416.6 186.1 A 206 160.7 25 0 1 439.0 331.9"; stroke: root.signal.with-alpha(0.44); stroke-width: 0.9px; transform-rotation: root.breath ? -4deg : 0deg; }
        Orbit { width: field.width; height: field.height; commands: "M 421.2 166.2 A 191 91.7 -28 0 1 396.5 248.0 M 362.6 283.4 A 191 91.7 -28 0 1 251.0 350.2 M 191.4 367.3 A 191 91.7 -28 0 1 104.6 361.1 M 78.8 333.8 A 191 91.7 -28 0 1 103.5 252.0 M 137.4 216.6 A 191 91.7 -28 0 1 249.0 149.8 M 308.6 132.7 A 191 91.7 -28 0 1 395.4 138.9"; stroke: #9c84f2.with-alpha(0.72); stroke-width: 1.4px; transform-rotation: root.breath ? -8deg : 0deg; }
        Orbit { width: field.width; height: field.height; commands: "M 334.5 382.7 A 173 102.1 38 0 1 189.5 332.3 M 158.1 304.4 A 173 102.1 38 0 1 100.1 181.4 M 108.7 150.9 A 173 102.1 38 0 1 203.0 118.5 M 254.6 134.3 A 173 102.1 38 0 1 379.7 245.2 M 394.1 277.6 A 173 102.1 38 0 1 367.1 372.8"; stroke: #5d8aeb.with-alpha(0.5); stroke-width: 1.05px; transform-rotation: root.breath ? 7deg : 0deg; }
        Orbit { width: field.width; height: field.height; commands: "M 394.2 285.9 A 154 129.4 -11 0 1 339.7 350.4 M 299.5 370.3 A 154 129.4 -11 0 1 216.6 378.8 M 167.5 364.2 A 154 129.4 -11 0 1 116.0 320.5 M 97.7 272.1 A 154 129.4 -11 0 1 115.3 195.6 M 142.5 163.3 A 154 129.4 -11 0 1 215.2 125.3 M 268.3 119.9 A 154 129.4 -11 0 1 338.5 138.9 M 380.3 174.4 A 154 129.4 -11 0 1 403.0 247.7"; stroke: root.signal.with-alpha(0.47); stroke-width: 0.8px; transform-rotation: root.breath ? -3deg : 0deg; }
        Orbit { width: field.width; height: field.height; commands: "M 371.2 285.1 A 127 86.4 10 0 1 311.4 331.8 M 280.8 337.3 A 127 86.4 10 0 1 191.2 321.5 M 159.6 302.2 A 127 86.4 10 0 1 124.5 246.1 M 128.8 214.9 A 127 86.4 10 0 1 188.6 168.2 M 219.2 162.7 A 127 86.4 10 0 1 308.8 178.5 M 340.4 197.8 A 127 86.4 10 0 1 375.5 253.9"; stroke: root.signal.with-alpha(0.78); stroke-width: 1.4px; transform-rotation: root.breath ? 5deg : 0deg; }
        Orbit { width: field.width; height: field.height; commands: "M 338.4 229.5 A 94 72.4 -32 0 1 316.5 287.0 M 296.5 305.8 A 94 72.4 -32 0 1 237.2 328.7 M 208.1 326.4 A 94 72.4 -32 0 1 169.6 298.7 M 161.6 270.5 A 94 72.4 -32 0 1 183.5 213.0 M 203.5 194.2 A 94 72.4 -32 0 1 262.8 171.3 M 291.9 173.6 A 94 72.4 -32 0 1 330.4 201.3"; stroke: root.signal.with-alpha(0.55); stroke-width: 1.15px; transform-rotation: root.breath ? -9deg : 0deg; }
        Orbit { width: field.width; height: field.height; commands: "M 310.6 282.9 A 69 50.4 27 0 1 243.8 301.5 M 225.0 293.8 A 69 50.4 27 0 1 184.5 234.1 M 189.4 217.1 A 69 50.4 27 0 1 249.3 196.9 M 275.0 206.2 A 69 50.4 27 0 1 315.3 268.6"; stroke: root.signal.with-alpha(0.91); stroke-width: 1.5px; transform-rotation: root.breath ? 10deg : 0deg; }
        Orbit { width: field.width; height: field.height; commands: "M 383.0 221.7 L 390.9 220.1 M 384.8 232.5 L 388.8 232.0 M 385.5 243.4 L 389.5 243.2 M 385.2 254.4 L 389.2 254.5 M 383.9 265.3 L 391.8 266.2 M 381.6 276.1 L 385.4 276.9 M 378.2 286.7 L 382.0 287.8 M 373.9 297.0 L 377.5 298.4 M 368.6 307.0 L 375.6 310.4 M 362.5 316.5 L 365.8 318.5 M 355.4 325.6 L 358.5 327.8 M 347.6 334.0 L 350.5 336.5 M 339.0 341.9 L 344.3 347.3 M 276.0 372.4 L 276.8 376.0 M 264.3 374.4 L 264.7 378.0 M 252.5 375.4 L 252.7 382.8 M 240.7 375.5 L 240.4 379.2 M 228.9 374.7 L 228.3 378.3 M 217.4 372.9 L 216.4 376.5 M 206.0 370.1 L 203.4 377.2 M 195.0 366.5 L 193.4 369.9 M 184.4 361.9 L 182.5 365.2 M 174.3 356.5 L 172.1 359.7 M 164.8 350.3 L 159.8 356.2 M 156.0 343.4 L 153.2 346.1 M 147.8 335.7 L 144.8 338.2 M 117.0 278.3 L 109.1 279.9 M 115.2 267.5 L 111.2 268.0 M 114.5 256.6 L 110.5 256.8 M 114.8 245.6 L 110.8 245.5 M 116.1 234.7 L 108.2 233.8 M 118.4 223.9 L 114.6 223.1 M 121.8 213.3 L 118.0 212.2 M 126.1 203.0 L 122.5 201.6 M 131.4 193.0 L 124.4 189.6 M 137.5 183.5 L 134.2 181.5 M 144.6 174.4 L 141.5 172.2 M 152.4 166.0 L 149.5 163.5 M 161.0 158.1 L 155.7 152.7 M 224.0 127.6 L 223.2 124.0 M 235.7 125.6 L 235.3 122.0 M 247.5 124.6 L 247.3 117.2 M 259.3 124.5 L 259.6 120.8 M 271.1 125.3 L 271.7 121.7 M 282.6 127.1 L 283.6 123.5 M 294.0 129.9 L 296.6 122.8 M 305.0 133.5 L 306.6 130.1 M 315.6 138.1 L 317.5 134.8 M 325.7 143.5 L 327.9 140.3 M 335.2 149.7 L 340.2 143.8 M 344.0 156.6 L 346.8 153.9 M 352.2 164.3 L 355.2 161.8"; stroke: #b1d9ed.with-alpha(0.59); }
        // Distribute points on sphere latitudes and project with a depth-dependent scale.
        for point in 52: Rectangle {
            property <float> latitude: (point + 0.5) / 52 * 2 - 1;
            property <float> ring: Math.sqrt(1 - latitude * latitude);
            property <angle> azimuth: point * 137.508deg + root.phase;
            property <float> depth: Math.sin(azimuth) * ring;
            property <float> perspective: 0.84 / (1 - 0.28 * depth);
            property <float> radius: Math.mod(point, 5) == 0 ? 0.42 : 0.72;
            property <float> tilt-y: latitude * 0.86 - depth * 0.5;
            x: field.width / 2 + Math.cos(azimuth) * ring * perspective * radius * field.width / 2 - self.width / 2;
            y: field.height / 2 + tilt-y * perspective * radius * field.height / 2 - self.height / 2;
            width: (Math.mod(point, 9) == 0 ? 6px : 3px) * perspective;
            height: self.width;
            border-radius: self.width / 2;
            background: (Math.mod(point, 13) == 0 ? #ffe6ac : Math.mod(point, 5) == 0 ? #a990ff : root.signal).with-alpha(0.46 + (depth + 1) * 0.24);
        }
    }
}
