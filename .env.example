# Synapse never requires cloud keys for local use.
# Copy to .env only on your own machine. Do not commit .env.

SYNAPSE_OLLAMA_BASE_URL=http://localhost:11434/v1
SYNAPSE_OLLAMA_MODEL=gemma4:e4b

SYNAPSE_LMSTUDIO_BASE_URL=http://localhost:1234/v1
SYNAPSE_LMSTUDIO_MODEL=local-model

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
