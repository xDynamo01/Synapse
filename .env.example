SYNAPSE_DATA_DIR=./data
SYNAPSE_HOST=127.0.0.1
# Fixed port for browser development and Docker; release desktop resolves a dynamic port.
SYNAPSE_PORT=8717
SYNAPSE_DEFAULT_ACTOR_ID=local_owner
SYNAPSE_SEARXNG_URL=http://127.0.0.1:8080

# Local SearXNG development only. Override this in an ignored .env if exposed beyond localhost.
SEARXNG_SECRET=synapse-local-dev-only-change-me
