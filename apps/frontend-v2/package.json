{
  "name": "synapse-frontend-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main/main/main.js",
  "scripts": {
    "prebuild": "npm run runtime:hygiene",
    "build": "npm run build:main && npm run build:renderer",
    "build:backend-sidecar": "powershell -NoProfile -ExecutionPolicy Bypass -File ..\\..\\scripts\\build_backend_sidecar.ps1 -PythonPath ..\\..\\.venv\\Scripts\\python.exe",
    "build:main": "tsc -p tsconfig.main.json && node scripts/write-preload-cjs.mjs",
    "build:renderer": "vite build",
    "dev": "npm run build:main && electron dist/main/main/main.js",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:electron-smoke": "npm run build && cross-env SYNAPSE_ELECTRON_SMOKE=1 electron dist/main/main/main.js",
    "runtime:hygiene": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clean-stale-runtime-artifacts.ps1"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@typescript-eslint/eslint-plugin": "8.68.0",
    "@typescript-eslint/parser": "8.68.0",
    "@vitejs/plugin-react": "6.1.0",
    "cross-env": "10.1.0",
    "electron": "43.4.1",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "pixi.js": "8.20.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
